# ATAQUE
# Ã¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢ÂÃ¢â€¢Â

func _try_attack() -> bool:
	var nearest : Node = _find_nearest_enemy()
	if nearest == null:
		return false
	if global_position.distance_to(nearest.global_position) > ATTACK_RANGE:
		return false
	var step_dmg : int = COMBO_DAMAGE[_combo_step]
	if not consume_energy(ATTACK_ENERGY):
		return false
	_perform_attack(nearest, step_dmg)
	return true

func _perform_attack(target: Node, dmg: int) -> void:
	_is_attacking          = true
	_attack_cooldown_timer = ATTACK_COOLDOWN
	_combo_reset_timer     = COMBO_RESET
	facing_right           = target.global_position.x > global_position.x
	sprite.flip_h          = not facing_right
	sprite.play("use_tool")

	if has_node("/root/AudioManager"):
		AudioManager.play_sfx("attack", randf_range(-0.1, 0.1))

	# Knockback al enemigo
	var kb_dir : Vector2 = Vector2(sign(target.global_position.x - global_position.x), -0.3).normalized()
	var kb_force : float = COMBO_KNOCKBACK[_combo_step]

	if target.has_method("take_damage"):
		target.take_damage(dmg)

	# Aplicar knockback si el enemigo tiene velocity
	if "velocity" in target:
		target.velocity += kb_dir * kb_force

	# Flash de golpe
	var tween := create_tween()
	tween.tween_property(sprite, "modulate", Color(1.5, 1.2, 0.5), 0.06)
	tween.tween_property(sprite, "modulate", Color.WHITE, 0.15)

	if has_node("/root/GameManager"):
		GameManager.shake_camera(3.0 + float(_combo_step) * 1.5, 0.12)

	# Avanzar combo
	_combo_step = (_combo_step + 1) % COMBO_DAMAGE.size()
	_is_attacking = false

func _find_nearest_enemy() -> Node:
	var enemies      := get_tree().get_nodes_in_group("enemies")
	var nearest      : Node  = null
	var nearest_dist : float = ATTACK_RANGE + 1.0
	for enemy in enemies:
		if not is_instance_valid(enemy): continue
		if enemy.has_method("is_alive") and not enemy.is_alive(): continue
		var d := global_position.distance_to(enemy.global_position)
		if d < nearest_dist:
			nearest_dist = d
			nearest      = enemy
	return nearest


