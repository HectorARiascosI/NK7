# ── Godot cache y temporales ──────────────────────────────────
.godot/imported/
.godot/shader_cache/
.godot/editor/
*.tmp
*.bak
*.backup

# ── Exportaciones ─────────────────────────────────────────────
export/
builds/
*.exe
*.apk
*.aab
*.ipa
*.pck
*.zip

# ── Scripts de herramientas temporales ────────────────────────
tools/
*.py

# ── Archivos de desarrollo temporal ──────────────────────────
*_preview.png
*_extracted.png
*IMPLEMENTATION.md
*.backup
image.png

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
