;; ══════════════════════════════════════════════════════════════════
;; LASER VERTICAL
;; Sprite2D estático con el frame activo → sin parpadeo involuntario
;; El script lo oculta/muestra cuando parpadea (modo blink/patrol)
;; ══════════════════════════════════════════════════════════════════

[node name="LaserV" type="Node2D"]
script = ExtResource("1_script")
mode = 1
blink_on_time = 1.8
blink_off_time = 0.9

;; Sprite estático — frame activo del láser vertical
[node name="Sprite" type="Sprite2D" parent="."]
position = Vector2(0, 147)
texture = ExtResource("3_on")
centered = true

[node name="BeamArea" type="Area2D" parent="."]
collision_layer = 0
collision_mask  = 1

[node name="BeamShape" type="CollisionShape2D" parent="BeamArea"]
