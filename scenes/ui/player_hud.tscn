;; ── STAMINA ──────────────────────────────────────────────────────
;; Capas (abajo→arriba): BgGris → FillVerde/Azul (recortado) → Marco encima

[node name="RowStamina" type="Control" parent="Root"]
layout_mode = 0
offset_left = 14.0
offset_top = 84.0
offset_right = 325.0
offset_bottom = 124.0
mouse_filter = 2

;; 1. Fondo gris — siempre visible, dentro del area interior
[node name="BgStamina" type="ColorRect" parent="Root/RowStamina"]
layout_mode = 0
offset_left = 30.0
offset_top = 5.0
offset_right = 292.0
offset_bottom = 35.0
mouse_filter = 2
color = Color(0.15, 0.16, 0.18, 1.0)

;; 2. Fill verde/azul — se recorta de derecha a izquierda
[node name="BarClip_Stamina" type="Control" parent="Root/RowStamina"]
layout_mode = 0
offset_left = 30.0
offset_top = 5.0
offset_right = 292.0
offset_bottom = 35.0
clip_contents = true
mouse_filter = 2

[node name="BarFill_Stamina" type="TextureRect" parent="Root/RowStamina/BarClip_Stamina"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
